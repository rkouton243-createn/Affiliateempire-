{
  "manifest_version": 3,
  "name": "X-Ray Vision Extension",
  "version": "1.0",
  "description": "Rend les éléments de la page transparents pour voir ce qu'il y a derrière.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
